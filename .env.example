# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/incident_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root
# "update" is convenient for local dev; use "validate" (+ a migration tool)
# in any environment that matters.
DB_SCHEMA_MODE=update

# --- JWT ---
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# --- AI triage (Groq) ---
# Get a free key at https://console.groq.com
# Leave blank to run with AI triage disabled (falls back to a safe default).
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant

# --- Server ---
SERVER_PORT=8080
LOG_LEVEL=INFO
